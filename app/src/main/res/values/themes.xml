<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for Wear OS -->
    <style name="Theme.YTWatch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary colors (AppCompat) -->
        <item name="colorPrimary">@color/yt_red</item>
        <item name="colorPrimaryDark">@color/yt_red_dark</item>
        <item name="colorAccent">@color/yt_red</item>
        
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/wear_background</item>
        <item name="android:windowBackground">@color/wear_background</item>
        
        <!-- Typography -->
        <item name="android:textColorPrimary">@color/wear_text_primary</item>
        <item name="android:textColorSecondary">@color/wear_text_secondary</item>
        <item name="android:textColorHint">@color/wear_text_disabled</item>
        
        <!-- Window -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Wear OS specific -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <!-- Round screen variant -->
    <style name="Theme.YTWatch.Round" parent="Theme.YTWatch">
        <item name="android:windowBackground">@drawable/bg_round_watch</item>
    </style>
    
    <!-- Splash theme -->
    <style name="Theme.YTWatch.Splash" parent="Theme.YTWatch">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>